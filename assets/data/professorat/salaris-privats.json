  "scope": {
    "jurisdiction": "Catalunya",
    "staff": "professor o professora titular de primària, jornada completa",
    "measure": "mínim brut mensual de conveni",
    "included": "salari base de la categoria",
    "excluded": "antiguitat, plus de transport, complement d'analogia, complement específic, càrrecs, complements voluntaris i altres conceptes",
